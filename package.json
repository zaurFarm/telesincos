{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:api": "tsx server.ts",
    "dev:workers": "IS_WORKER=true tsx apps/workers/index.ts",
    "dev:monitor": "tsx apps/monitor/index.ts",
    "dev:cron": "tsx apps/cron/index.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:workers\" \"npm run dev:monitor\" \"npm run dev:cron\"",
    "start:api": "node dist/server.cjs",
    "start:workers": "IS_WORKER=true node dist/apps/workers/index.cjs",
    "start:monitor": "node dist/apps/monitor/index.cjs",
    "start:cron": "node dist/apps/cron/index.cjs",
    "start": "node dist/server.cjs",
    "build:api": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:workers": "esbuild apps/workers/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/apps/workers/index.cjs",
    "build:monitor": "esbuild apps/monitor/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/apps/monitor/index.cjs",
    "build:cron": "esbuild apps/cron/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/apps/cron/index.cjs",
    "build:server": "npm run build:api && npm run build:workers && npm run build:monitor && npm run build:cron",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "chaos": "tsx src/tests/chaosRunner.ts",
    "smoke": "tsx src/tests/smoke.ts",
    "readiness": "tsx src/tests/readiness.ts",
    "health": "tsx src/tests/healthcheck.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.74.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "framer-motion": "^12.39.0",
    "https-proxy-agent": "^9.0.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "input": "^1.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.35.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "redis-lock": "^1.0.0",
    "socks-proxy-agent": "^10.0.0",
    "string-similarity": "^4.0.4",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/pg": "^8.20.0",
    "@types/string-similarity": "^4.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "ioredis-mock": "^8.13.1",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "node-domexception": "file:./packages/node-domexception",
    "domexception": "file:./packages/node-domexception"
  }
}
